# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# INUS audit generated data
.agents/reports/symbol-audit.json
.agents/reports/structural-audit.json
.agents/reports/prioritization.json
.agents/reports/test-results.json

# INUS local backups / temporary artifacts
/.backup/
*.before-*
*.bak

# INUS temporary validation configs
/tsconfig.*-check.json

# INUS local audit outputs
/audit-*.ts
/*audit*.txt
/collision-details.txt
/duplicate-*.txt

# INUS media / archives
/*.zip
/*.mp3

# INUS local benchmark / generated pipeline working data
/data/benchmark-*/
/data/generated-symbols/

# INUS design / preview workspaces
/app/design-lab/
/app/preview/

# INUS local agent working outputs
/.agents/proposals/
/.agents/reports/review-*.json

# INUS local experiments
/generation-test.ts
/research-generation-test.ts
/test-perplexity*.mts
/video-system/
